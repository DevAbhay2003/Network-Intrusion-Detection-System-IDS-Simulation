# Network Intrusion Detection System (IDS) Simulation Configuration
# Copy this file to .env for local adjustments

# Application Environment
APP_ENV=development
APP_NAME="SOC Network Intrusion Detection System"
DEBUG=True

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///./backend/ids_database.db

# IDS Detection Weights (Must sum to 1.0)
# When ML is enabled:
WEIGHT_RULES=0.40
WEIGHT_ANOMALY=0.30
WEIGHT_ML=0.30

# When ML is disabled:
WEIGHT_RULES_NO_ML=0.60
WEIGHT_ANOMALY_NO_ML=0.40

# Rule Detection Thresholds
THRESHOLD_HIGH_CONNECTION_RATE=25.0
THRESHOLD_FAILED_CONNECTION_COUNT=5
THRESHOLD_UNIQUE_DEST_PORTS=15
THRESHOLD_SYN_RATIO=0.75
THRESHOLD_HIGH_BYTE_VOLUME=500000

# Anomaly Baseline Configuration
ANOMALY_ZSCORE_THRESHOLD=2.5
ANOMALY_SENSITIVITY=1.0

# Alert Correlation Window (seconds)
ALERT_CORRELATION_WINDOW_SECONDS=60

# Simulator Defaults
SIMULATOR_SPEED=fast
SIMULATOR_MODE=mixed
SIMULATOR_INTERVAL_SECONDS=1.0
